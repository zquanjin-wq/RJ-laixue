# One-off, non-interactive migration image for Supabase -> AIDAP.
# It deliberately has no web server and is deployed as a separate Dokploy service.
FROM node:20-alpine AS base

RUN apk add --no-cache postgresql17-client
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ ./packages/
COPY scripts/ ./scripts/

# The migration job only uses pg and supabase-js. Do not run the web app's
# postinstall hook here: it builds unrelated browser assets and makes this
# one-off job needlessly fragile.
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY scripts/aidap-migration-job.mjs ./scripts/aidap-migration-job.mjs

CMD ["node", "scripts/aidap-migration-job.mjs"]
