# Copy to .env.deploy on the server. Never commit .env.deploy.
# NEXT_PUBLIC_* values are embedded in the browser bundle at image build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application security and scheduled-job authentication
ACCESS_CODE=
CRON_SECRET=replace-with-a-long-random-value

# Add only the AI/media provider variables used by production.
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEFAULT_MODEL=

# Deployment metadata
LAIXUE_IMAGE_TAG=local
