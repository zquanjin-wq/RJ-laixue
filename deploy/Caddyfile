{
	admin off
}

(laixue_proxy) {
	encode zstd gzip

	@api path /api/*
	header @api Cache-Control "no-store"

	reverse_proxy laixue:3000 {
		flush_interval -1
		transport http {
			dial_timeout 10s
			response_header_timeout 10m
		}
	}

	log {
		output stdout
		format json
	}
}

# Keeps the pre-cutover machine testable by IP over HTTP. The application
# itself never exposes port 3000 to the public network.
:80 {
	import laixue_proxy
}

# Caddy obtains and renews the Let's Encrypt certificate after this hostname
# resolves to this server. Until that point, the HTTP test endpoint above still
# works; certificate retries do not prevent the app from starting.
{$LAIXUE_DOMAIN} {
	import laixue_proxy
}

www.{$LAIXUE_DOMAIN} {
	redir https://{$LAIXUE_DOMAIN}{uri} permanent
}
